{
  "compilerOptions": {
    "target": "ES2020", "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"], "skipLibCheck": true,
    "module": "ESNext", "moduleResolution": "Bundler", "allowJs": true,
    "isolatedModules": true, "noEmit": true, "strict": true, "strictPropertyInitialization": false
  },
  "include": ["src"]
}
